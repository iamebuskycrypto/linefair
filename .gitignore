*.log
npm-debug.log*
# Editor/OS
.idea/
.vscode/
# NOTE: proptest-regressions/ is intentionally NOT ignored (commit failure seeds).
# NOTE: `*seed*` above also ignores any file merely named with "seed"; rename such files rather than weakening the rule.

# Local deployment config (account ids only; never keys)
deploy/testnet.config.json

# Python bytecode (preflight tests import the script)
__pycache__/

# escrow2 recovery preflight config (public account ids only; local)
deploy/testnet-escrow2.config.json
