# Public build-time values only (copied into the browser bundle).
# NEVER put keys, seed phrases, passwords or API tokens here or in any VITE_ variable.
# The app refuses to start on anything but NEAR testnet.
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_NEAR_EXPLORER_URL=https://testnet.nearblocks.io
# Empty until the escrow and test token are deployed (LF-014, founder approval required).
# When VITE_ESCROW_ID is set, VITE_FT_ID is required, and the app refuses to start unless the
# escrow's code hash, contract_version and get_config match src/lib/deployment.ts.
VITE_ESCROW_ID=
VITE_FT_ID=
