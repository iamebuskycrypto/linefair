      {
        "name": "on_withdrawal_transfer",
        "doc": " LF-009 private callback (`docs/27` R-1). Only the escrow itself may call\n it. Total: never panics for the genuine callback; anything that does\n not match the exact PENDING withdrawal (id, epoch, line, beneficiary)\n changes nothing. Successful transfer → PAID and E −= amount (checked;\n an underflow keeps it PENDING and logs an incident). Failed transfer →\n FAILED, amount restored to claimable once, E unchanged.",
        "kind": "call",
        "modifiers": [
          "private"
        ],
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "agreement_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "line_id",
              "type_schema": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              }
            },
            {
              "name": "beneficiary",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "withdrawal_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "epoch",
