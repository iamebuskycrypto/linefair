      {
        "name": "open_dispute",
        "doc": " LF-006: the buyer disputes a SUBMITTED line inside its review window\n (T0 = now). Funds stay locked; no allocation is made here.",
        "kind": "call",
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "agreement_id",
              "type_schema": {
                "type": "string"
